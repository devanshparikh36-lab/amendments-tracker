# ---- worker (GitHub Actions: .github/workflows/worker.yml) ----
# These live in the repository's Actions secrets, not on a host. Railway ran the worker until 6 Sept 2026 and
# is gone; the project is deleted.
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5
AI_ENABLED=false
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_BUCKET=regulation-tracker
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=https://files.your-domain.com
TEAMS_WEBHOOK_URL=https://<tenant>.webhook.office.com/webhookb2/...
RESEND_API_KEY=re_...
DIGEST_FROM=As Amended <tracker@your-domain.com>
DIGEST_TO=team@kcmehta.com
REQUEST_DELAY_SECONDS=1.0
MIN_DOCUMENT_YEAR=2014

